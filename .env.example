# MCP Server Configuration
# ========================

# Protocol: "mcp" (JSON-RPC 2.0 with streamable HTTP) or "rest"
MCP_PROTOCOL=mcp

# Server URL - base URL of the MCP server
MCP_SERVER_URL=http://localhost:3000

# Endpoint Configuration (choose ONE approach):
#
# APPROACH 1: Full URL in MCP_SERVER_URL (simplest)
# -------------------------------------------------
# Put the complete URL including endpoint path:
#   MCP_SERVER_URL=https://example.com/mcp
# Leave endpoint fields empty:
#   TOOLS_LIST_ENDPOINT=
#   TOOLS_CALL_ENDPOINT=
#
# APPROACH 2: Base URL + MCP_ENDPOINT (recommended)
# --------------------------------------------------
# Base URL without endpoint:
#   MCP_SERVER_URL=https://example.com
# Single endpoint for all MCP calls:
#   MCP_ENDPOINT=/mcp
#
# APPROACH 3: Base URL + Separate endpoints (legacy)
# ---------------------------------------------------
# Base URL:
#   MCP_SERVER_URL=https://example.com
# Different endpoints for list vs call:
#   TOOLS_LIST_ENDPOINT=/tools/list
#   TOOLS_CALL_ENDPOINT=/tools/call

# Uncomment and set based on your approach:
# MCP_ENDPOINT=/mcp
# TOOLS_LIST_ENDPOINT=/tools/list
# TOOLS_CALL_ENDPOINT=/tools/call

# Request timeout in milliseconds
REQUEST_TIMEOUT=30000

# Tools directory path
TOOLS_DIR=./tools

# Base request config file path
BASE_REQUEST_PATH=./base-request.json

# Variables file for ${VAR_NAME} substitution in test cases
VARIABLES_PATH=./variables.json

# Output format: "console", "json", "junit"
OUTPUT_FORMAT=console

# Test case variables (alternative to variables.json)
# These can be used as ${ADDRESS_ID}, etc. in test cases
# ADDRESS_ID=231231
# PRODUCT_ID=20000007050256

# Auth tokens (used by base-request.json)
# AUTH_TOKEN=your-bearer-token
# AUTH_USERNAME=your-username
# AUTH_PASSWORD=your-password
# API_KEY=your-api-key

# OAuth 2.0 Configuration (used when auth.type is "oauth")
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_SCOPE=read write
